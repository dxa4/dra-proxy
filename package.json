{
  "name": "x5-proxy",
  "version": "1.0.0",
  "description": "Local CORS proxy for X5 Copilot API",
  "main": "local.js",
  "bin": "local.js",
  "pkg": {
    "scripts": "local.js",
    "targets": [
      "node20-win-x64",
      "node20-macos-x64",
      "node20-macos-arm64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "start": "node local.js",
    "build": "pkg . --compress GZip"
  }
}
